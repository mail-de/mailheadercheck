#!/usr/bin/env python3

import argparse
import signal
import sys
import Milter
from mailheaderchecklib.utility import Logger, Cfg
from mailheaderchecklib.mailheadercheckmilter import MailHeaderCheckMilter
from mailheaderchecklib.checks import CHECKS

NAME = "mailheadercheck"
VERSION = "2025.2"

try:
    # noinspection PyUnresolvedReferences
    import setproctitle
    setproctitle.setproctitle(NAME)
except ImportError:
    pass

__version__ = VERSION
__author__ = "see AUTHORS file"
__copyright__ = "Copyright (C) by AUTHORS"


# noinspection PyProtectedMember,PyUnresolvedReferences
if __name__ == "__main__":
    parser = argparse.ArgumentParser(epilog=NAME)

    parser.add_argument("--config", "-c",
                        type=str,
                        default="",
                        help="Path to config file. If not provided, the following order will be tested: /etc/mailheadercheck/config.yaml, ./config.yaml")
    parser.add_argument("--configcheck",
                        action="store_true",
                        help="Validate the configuration file and exit (does not start the milter)")
    parser.add_argument("--version", "-V", action="version", version=f"{NAME} {VERSION}")
    params = parser.parse_args()

    config = Cfg.find_and_parse_config_file(params.config)

    # Run config validation before starting the milter
    allowed_checks = {check.name for check in CHECKS}
    if params.configcheck:
        errors = Cfg.validate_config(config, allowed_checks)
        for e in errors:
            print(f"ERROR: {e}")
        if errors:
            sys.exit(1)
        else:
            print("Config validation successful.")
            sys.exit(0)

    # Normal startup: validation
    errors = Cfg.validate_config(config, allowed_checks)
    for e in errors:
        print(f"ERROR: {e}")
    if errors:
        sys.exit(1)

    """ init logger """
    if config['log_target'] == 'syslog':
        logging = Logger.getSyslogLogger(config)
    elif config['log_target'] == 'file':
        logging = Logger.getFileLogger(config)
    elif config['log_target'] == 'stdout':
        logging = Logger.getStdoutLogger(config)
    else:
        # Fallback to stdout if log_target is misconfigured
        logging = Logger.getStdoutLogger(config)

    logging.info("{0}-{1} milter startup".format(NAME, VERSION))

    Cfg.config = config
    Cfg.logging = logging

    Milter.factory = MailHeaderCheckMilter

    flags = Milter.ADDHDRS
    Milter.set_flags(flags)

    config_path = params.config

    def handle_sighup(signum: int, frame: object) -> None:
        logging.info(f"{NAME}: SIGHUP received, reloading config")
        try:
            new_config = Cfg.find_and_parse_config_file(config_path)
        except SystemExit:
            logging.error(f"{NAME}: Config reload aborted: could not read config file")
            return
        errors = Cfg.validate_config(new_config, allowed_checks)
        if errors:
            for err in errors:
                logging.error(f"{NAME}: Config reload failed: {err}")
            logging.error(f"{NAME}: Config NOT reloaded — fix the errors above and send SIGHUP again")
            return
        Cfg.config = new_config
        logging.info(f"{NAME}: Config reloaded successfully")

    signal.signal(signal.SIGHUP, handle_sighup)

    Milter.runmilter(NAME, config['socket'], timeout=300)

    sys.exit(0)

